# Plantilla de variables de entorno para desarrollo local.
# NO usar como .env real — los secretos se inyectan con Infisical (Agents.md §2).
# Copiar los nombres, rellenar valores en Infisical; este fichero no tiene valores reales.

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
APP_DISPLAY_TIMEZONE=Europe/Madrid

# ── Base de datos ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://saas:saas@localhost:5432/saas  # pragma: allowlist secret
REDIS_URL=redis://localhost:6379/0

# ── Storage (Cloudflare R2 / MinIO local) ─────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=saas-files
R2_ENDPOINT_URL=http://localhost:9000
R2_PUBLIC_URL=
R2_REGION=auto
STORAGE_PRESIGNED_TTL_SECONDS=3600

# ── Auth (Clerk) ───────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=

# ── LLM providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=

# ── Observabilidad (Langfuse) ──────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── Overrides de router de modelos (opcional) ─────────────────────────────────
# Si no se definen, LLMClient usa los DEFAULT_MODELS de llm/client.py.
# LLM_MODEL_EXTRACTION=
# LLM_MODEL_CHAT=
# LLM_MODEL_CLASSIFY=
# LLM_MODEL_SQL=

# ── Chat documental (Paso 16) ─────────────────────────────────────────────────
KNOWLEDGE_TOOLS_ENABLED=true
KNOWLEDGE_CHAT_MAX_CITATIONS=5
KNOWLEDGE_CHAT_MIN_SCORE_THRESHOLD=0.35
CHAT_DAILY_MESSAGE_LIMIT=60
CHAT_MAX_MESSAGE_BYTES=4096
CHAT_HISTORY_MESSAGE_LIMIT=20
CHAT_STREAM_CHUNK_CHARS=80

# ── Reintentos LLM ────────────────────────────────────────────────────────────
LLM_RETRY_TRANSIENT_ERRORS=false
LLM_RETRY_MAX_ATTEMPTS=4
LLM_RETRY_MAX_WAIT_SECONDS=15.0

# ── Google Calendar OAuth (Paso 17) ───────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CALENDAR_SCOPES=  # usar valor por defecto de config.py

# ── Cifrado de campos sensibles ───────────────────────────────────────────────
ENCRYPTION_KEY=

# ── Métricas internas (Paso 15) ───────────────────────────────────────────────
METRICS_TOKEN=

# ── Knowledge / RAG ingesta (Paso 18) ─────────────────────────────────────────
KNOWLEDGE_MAX_FILE_SIZE_BYTES=15728640
KNOWLEDGE_CHUNK_TARGET_TOKENS=600
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=100
KNOWLEDGE_EMBEDDING_MODEL=voyage-3-lite
KNOWLEDGE_EMBEDDING_DIMENSIONS=512
KNOWLEDGE_INDEX_MAX_CONCURRENT_PER_TENANT=3
# KNOWLEDGE_ALLOWED_MIMES=  # usar valor por defecto de config.py
KNOWLEDGE_CONTEXTUAL_RETRIEVAL_ENABLED=false
